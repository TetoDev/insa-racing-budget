# Example Nginx site configuration when the VPS already terminates HTTPS with Nginx
# instead of using `docker compose --profile proxy`.
#
# Save as /etc/nginx/sites-available/insa-achats.conf, enable it, and run:
#   sudo certbot --nginx -d achats.insa-racing.fr

server {
    listen 80;
    listen [::]:80;
    server_name achats.insa-racing.fr;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name achats.insa-racing.fr;

    # Managed by Certbot or your SSL certificate paths:
    ssl_certificate     /etc/letsencrypt/live/achats.insa-racing.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/achats.insa-racing.fr/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Match Caddyfile max body size so multi-file invoice/CAD uploads succeed
    client_max_body_size 100M;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
