{
  "name": "insa-racing-achats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy:hash-password": "node scripts/deploy-check.mjs --hash-password",
    "prod:up": "docker compose up -d --build --wait",
    "prod:proxy": "docker compose --profile proxy up -d --build --wait",
    "local:up": "docker compose -f docker-compose.local.yml up -d --build",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "local:reset": "docker compose -f docker-compose.local.yml down -v",
    "local:logs": "docker compose -f docker-compose.local.yml logs -f"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.2.2",
    "archiver": "^7.0.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-solid": "^0.511.0",
    "nitro": "^3.0.260610-beta",
    "nodemailer": "^7.0.3",
    "pdfkit": "^0.17.1",
    "postgres": "^3.4.5",
    "solid-js": "^1.9.15",
    "vite": "^8.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.7.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.2",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
