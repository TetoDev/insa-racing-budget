# ==============================================================================
# INSA Racing — Purchase & Budget App Environment Configuration
# Copy to `.env` on your VPS (`cp .env.example .env`) and run:
#   npm run deploy:check
# ==============================================================================

# Public URL of the deployed application (used in invite & password reset emails)
APP_URL=https://achats.insa-racing.fr

# Session encryption secret (generate with: openssl rand -hex 32)
SESSION_SECRET=replace_with_a_64_char_random_hex_secret_at_least_32_bytes

# Leave unset to automatically require HTTPS cookies whenever APP_URL uses https://
# Set to false ONLY if temporarily testing over plain http:// without TLS
# COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# Master Account (Full Access + User Approvals + Season Management)
# ------------------------------------------------------------------------------
MASTER_EMAIL=president@insa-racing.fr
# Accepts plaintext OR a salted scrypt hash generated via:
#   npm run deploy:hash-password -- "YourStrongPassword"
MASTER_PASSWORD=replace_with_a_strong_master_password
MASTER_NAME="Master Admin"
MASTER_TITLE="Team President / Master"

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
# Use alphanumeric/underscore/hyphen characters in POSTGRES_PASSWORD (or set a
# URL-encoded DATABASE_URL override below if using special characters like @ or #).
POSTGRES_USER=insa_achats
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=insa_achats
# Optional override for external PostgreSQL; Docker Compose derives it from POSTGRES_* by default:
# DATABASE_URL=postgresql://insa_achats:replace_with_strong_db_password@postgres:5432/insa_achats

# ------------------------------------------------------------------------------
# SMTP Mail Server (OVH Zimbra — contact@insa-racing.fr)
# Standard OVH European SSL: host=ssl0.ovh.net port=465 secure=true
# Standard OVH European STARTTLS: host=ssl0.ovh.net port=587 secure=false
# (Or OVH Zimbra Europe: smtp.mail.ovh.net depending on your OVH mail plan)
# Test connectivity with: npm run deploy:check -- --verify-smtp
# ------------------------------------------------------------------------------
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@insa-racing.fr
SMTP_PASS=replace_with_your_mail_password
SMTP_FROM="INSA Racing Achats <contact@insa-racing.fr>"

# ------------------------------------------------------------------------------
# Private File Uploads
# ------------------------------------------------------------------------------
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=20

# Optional domain for Caddy reverse proxy (if using `docker compose --profile proxy up -d --build`)
DOMAIN=achats.insa-racing.fr
